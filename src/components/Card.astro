---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { normalisePath } from "@/utils/paths";
import Datetime from "./Datetime.astro";
import PageViews from "./PageViews.astro";
import { readingTime } from "@/utils/readingTime";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, ...props } = data;
const minutes = readingTime(body ?? "");

// normalise to match the api keys (trailing slash stripped), else the count drops
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
const postPath = normalisePath(postUrl) ?? postUrl;
---

<li class="my-6">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading>
      {title}
    </Heading>
  </a>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-2">
    <Datetime {...props} />
    <span aria-hidden="true" class="text-muted-foreground max-sm:hidden">|</span
    >
    <span class="text-muted-foreground text-sm">{minutes} min read</span>
    <span aria-hidden="true" class="text-muted-foreground max-sm:hidden">|</span
    >
    <PageViews path={postPath} class="text-muted-foreground text-sm" />
  </div>
  <p>{description}</p>
</li>
