---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  /**
   * Pagefind only indexes `data-pagefind-body` regions once any page declares
   * one, so every page that should be searchable has to carry it. Opt out for
   * pages that would only pollute the results, like the search page itself.
   */
  indexable?: boolean;
};

const { pageTitle, pageDesc, class: className, indexable = true } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  data-pagefind-body={indexable ? true : undefined}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <h1 class="text-2xl font-semibold sm:text-3xl">{pageTitle}</h1>
  <p class="mt-2 mb-6 italic">{pageDesc}</p>
  <slot />
</main>

<script>
  const mainContent: HTMLElement | null =
    document.querySelector("#main-content");
  const backUrl = mainContent?.dataset?.backurl;
  if (backUrl) {
    sessionStorage.setItem("backUrl", backUrl);
  }
</script>
