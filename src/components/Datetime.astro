---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const isModified = modDatetime && modDatetime > pubDatetime;

// toISOString() is the absolute instant in UTC; the timezone only shapes the
// displayed date. formatToParts lets us assemble exactly "5 Jul, 2026".
const instant = new Date(
  (isModified ? modDatetime : pubDatetime) as string | Date
);
const parts = new Intl.DateTimeFormat("en-US", {
  timeZone: postTimezone ?? config.site.timezone,
  day: "numeric",
  month: "short",
  year: "numeric",
}).formatToParts(instant);
const part = (type: Intl.DateTimeFormatPartTypes) =>
  parts.find(p => p.type === type)?.value ?? "";

const isoDatetime = instant.toISOString();
const date = `${part("day")} ${part("month")}, ${part("year")}`;
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        {t.post.updatedAt}:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={isoDatetime}
  >
    {date}
  </time>
</div>
