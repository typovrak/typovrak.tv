---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import GithubWall from "@/components/GithubWall.astro";
import LucideIcon from "@/components/LucideIcon.astro";
import RepoStats from "@/components/RepoStats.astro";
import TypingTrainer from "@/components/TypingTrainer.astro";
import HeadingLinks from "@/components/HeadingLinks.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { serialiseJsonLd } from "@/utils/jsonLd";
import {
  moduleCount,
  totalStars,
  totalForks,
  nixosCategories,
} from "@/data/nixos";
import { contributions } from "@/data/contributions";
import { repoStatsFor } from "@/data/githubRepos";
import config from "@/config";

const { socials, posts: postsConfig } = config;

// WebSite + SearchAction: lets Google offer a sitelinks search box. The target
// points at the Pagefind search page, which reads ?q=.
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: config.site.url,
  name: config.site.title,
  description: config.site.description,
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${config.site.url}search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={serialiseJsonLd(websiteLd)}
    />
  </Fragment>

  <Header />
  <main
    id="main-content"
    data-pagefind-body
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 mr-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hello World
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Notes on Linux, CLI tooling and web development. I write up what I've
        had to work out myself: Arch/NixOS setups, terminal configuration, and
        how the parts of a stack behave once you look closely.
      </p>
      <p class="mt-2">Posts are below.</p>

      <div class="mt-6">
        <GithubWall />
        <details class="mt-1 flex flex-col items-end text-sm">
          <summary
            class="hover:text-accent cursor-pointer list-none opacity-50"
          >
            ?
          </summary>
          <p class="text-muted-foreground mt-1 text-right italic">
            If you don't know what this wall represents, you will not understand
            a thing here.
          </p>
        </details>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section class="border-border border-b pt-12 pb-6">
          <h2 id="featured" class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section
      class:list={[
        "pt-12 pb-6",
        { "border-border border-b": recentPosts.length > 0 },
      ]}
    >
      <div class="border-accent/40 bg-accent/5 rounded-lg border p-6 sm:p-8">
        <h2 id="nixos" class="text-2xl font-semibold tracking-wide">
          NixOS config
        </h2>
        <p class="text-muted-foreground mt-2 max-w-prose">
          My NixOS setup is split into one module per tool, each in its own
          repo, from the window manager down to the shell.
        </p>

        <div class="text-accent/80 mt-5 flex flex-wrap gap-4">
          {
            nixosCategories.map(category => (
              <span title={`${category.title} modules`} class="inline-flex">
                <LucideIcon icon={category.icon} class="h-6 w-6" />
              </span>
            ))
          }
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-4">
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">
              {moduleCount}
            </div>
            <div class="text-muted-foreground mt-1 text-sm">modules</div>
          </div>
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">
              {totalStars}
            </div>
            <div class="text-muted-foreground mt-1 text-sm">stars</div>
          </div>
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">
              {totalForks}
            </div>
            <div class="text-muted-foreground mt-1 text-sm">forks</div>
          </div>
          <a
            href="/nixos"
            class="focus-outline bg-accent text-accent-foreground ms-auto inline-flex items-center gap-2 rounded-md px-4 py-2 font-medium transition-opacity hover:opacity-90"
          >
            Browse the config
            <IconArrowRight class="rtl:-rotate-180" />
          </a>
        </div>
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section class="pt-12 pb-6">
          <h2 id="recent-posts" class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }

    <section class="border-border border-t pt-12 pb-6">
      <div class="border-accent/40 bg-accent/5 rounded-lg border p-6 sm:p-8">
        <h2
          id="star-rune"
          class="flex items-center gap-2 text-2xl font-semibold tracking-wide"
        >
          <svg
            viewBox="0 0 16 16"
            width="24"
            height="24"
            fill="currentColor"
            aria-hidden="true"
            class="text-accent h-6 w-6 shrink-0"
          >
            <path
              d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
            ></path>
          </svg>
          Star Rune
        </h2>
        <p class="text-muted-foreground mt-2 max-w-prose">
          A typing game that teaches touch typing and chemistry through combat,
          for all ages. I build its open-source website, starrune.net, as a
          volunteer and typing enthusiast supporting the project.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-4">
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">
              $15,772
            </div>
            <div class="text-muted-foreground mt-1 text-sm">raised</div>
          </div>
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">145</div>
            <div class="text-muted-foreground mt-1 text-sm">backers</div>
          </div>
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">200+</div>
            <div class="text-muted-foreground mt-1 text-sm">Discord</div>
          </div>
          <div class="ms-auto flex flex-wrap items-center gap-3">
            <a
              href="https://github.com/typovrak/star-rune-landing-page"
              target="_blank"
              rel="noopener noreferrer"
              class="focus-outline border-accent text-accent hover:bg-accent/10 inline-flex items-center gap-2 rounded-md border px-4 py-2 font-medium transition-colors"
            >
              <svg
                viewBox="0 0 16 16"
                width="16"
                height="16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
                ></path>
              </svg>
              GitHub
            </a>
            <a
              href="https://starrune.net"
              target="_blank"
              rel="noopener noreferrer"
              class="focus-outline bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-md px-4 py-2 font-medium transition-opacity hover:opacity-90"
            >
              Visit starrune.net
              <IconArrowRight class="rtl:-rotate-180" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-border border-t pt-12 pb-6">
      <h2 id="contributions" class="text-2xl font-semibold tracking-wide">
        Open source contributions
      </h2>
      <p class="text-muted-foreground mt-2 max-w-prose">
        Projects I contribute to beyond my own.
      </p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          contributions.map(project => {
            const stats = repoStatsFor(project.repo);
            return (
              <li class="border-border rounded-md border p-3">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="focus-outline group block"
                >
                  <span class="text-accent font-semibold group-hover:underline">
                    {project.repo}
                  </span>
                  {project.inactive && (
                    <span
                      title="No longer maintained"
                      class="ms-2 rounded border border-orange-600/40 bg-orange-500/10 px-1.5 py-0.5 align-middle text-xs font-medium text-orange-700 dark:border-orange-400/40 dark:text-orange-400"
                    >
                      inactive
                    </span>
                  )}
                  <span class="text-muted-foreground mt-1 block text-sm">
                    {project.description}
                  </span>
                  <RepoStats
                    stars={stats.stars}
                    forks={stats.forks}
                    class="mt-2"
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    {/* Hidden on phones: the exercise needs a physical keyboard. */}
    <section class="border-border border-t pt-12 pb-6 max-sm:hidden">
      <h2 id="typing" class="text-2xl font-semibold tracking-wide">
        Type some Star Rune
      </h2>
      <p class="text-muted-foreground mt-2 max-w-prose">
        A random excerpt from the Star Rune website source, drawn fresh on every
        visit. Click the code and start typing.
      </p>
      <div class="mt-4">
        <TypingTrainer />
      </div>
    </section>
  </main>
  <Footer />

  <HeadingLinks />
</Layout>

<script>
  const indexLayout = (document.querySelector("#main-content") as HTMLElement)
    ?.dataset;
  const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  if (indexLayout?.layout) {
    sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
  }
</script>
