---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EmptyState from "@/components/EmptyState.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.notFound.title} | ${config.site.title}`}
  robots="noindex, follow"
>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <EmptyState glyph="404" message={t.notFound.message} heading />
  </main>

  <Footer />
</Layout>
