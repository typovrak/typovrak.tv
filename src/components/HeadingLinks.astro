---
// Appends a hover "#" anchor link to each content heading, so any prose page
// (posts, legal notices) gets the same behaviour. Rendered inside the page;
// the script runs once on load (no ClientRouter).
---

<script>
  for (const heading of document.querySelectorAll<HTMLElement>(
    "#main-content :is(h2, h3, h4, h5, h6)[id]"
  )) {
    heading.classList.add("group");
    const link = document.createElement("a");
    // text-accent so the "#" matches on non-prose pages (the home) too, where
    // it would otherwise inherit the body colour.
    link.className =
      "heading-link text-accent ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
    link.href = `#${heading.id}`;
    const hash = document.createElement("span");
    hash.ariaHidden = "true";
    hash.textContent = "#";
    link.appendChild(hash);
    heading.appendChild(link);
  }
</script>
