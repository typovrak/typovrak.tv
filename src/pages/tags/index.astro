---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import LucideIcon from "@/components/LucideIcon.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyAll } from "@/utils/slugify";
import { tagInfo } from "@/data/tags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const sorted = getSortedPosts(posts);

// tagInfo throws on an unregistered tag, so the build fails here rather than
// rendering a card with no description.
const cards = getUniqueTags(posts).map(({ tag }) => {
  const tagPosts = sorted.filter(({ data }) =>
    slugifyAll(data.tags).includes(tag)
  );
  const latest = tagPosts[0];
  return {
    tag,
    info: tagInfo(tag),
    count: tagPosts.length,
    latest: latest
      ? {
          title: latest.data.title,
          url: getPostUrl(latest.id, latest.filePath),
        }
      : undefined,
  };
});

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="mt-2 grid gap-4 sm:grid-cols-2">
      {
        cards.map(({ tag, info, count, latest }) => (
          <li class="border-border hover:border-accent/60 rounded-lg border p-4 transition-colors">
            <a
              href={getRelativeLocaleUrl(locale, `tags/${tag}`)}
              class="focus-outline group block"
            >
              <span class="flex items-center gap-2">
                <LucideIcon icon={info.icon} class="text-accent" />
                <span class="text-accent text-lg font-semibold group-hover:underline">
                  {info.label}
                </span>
                <span class="text-muted-foreground ms-auto text-sm tabular-nums">
                  {count} {count === 1 ? "post" : "posts"}
                </span>
              </span>
              <span class="text-muted-foreground mt-2 block text-sm">
                {info.description}
              </span>
            </a>
            {latest && (
              <p class="border-border text-muted-foreground mt-3 border-t pt-2 text-xs">
                Latest:{" "}
                <a
                  href={latest.url}
                  class="hover:text-accent underline decoration-dashed underline-offset-4"
                >
                  {latest.title}
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
