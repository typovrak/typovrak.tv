---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import GithubWall from "@/components/GithubWall.astro";
import HeadingLinks from "@/components/HeadingLinks.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { serialiseJsonLd } from "@/utils/jsonLd";
import config from "@/config";

const { socials, posts: postsConfig } = config;

// WebSite + SearchAction: lets Google offer a sitelinks search box. The target
// points at the Pagefind search page, which reads ?q=.
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: config.site.url,
  name: config.site.title,
  description: config.site.description,
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${config.site.url}search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={serialiseJsonLd(websiteLd)}
    />
  </Fragment>

  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 mr-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hello World
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Notes on Linux, CLI tooling and web development. I write up what I've
        had to work out myself: Arch setups, terminal configuration, and how the
        parts of a stack behave once you look closely.
      </p>
      <p class="mt-2">
        Posts are below. There's also{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="/about"
        >
          more about me
        </LinkButton>.
      </p>

      <div class="mt-6">
        <GithubWall />
        <details class="mt-1 text-sm">
          <summary
            class="hover:text-accent w-fit cursor-pointer list-none opacity-50"
          >
            ?
          </summary>
          <p class="text-muted-foreground mt-1 italic">
            If you don't know what this wall represents, you will not understand
            a thing here.
          </p>
        </details>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 id="featured" class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="pt-12 pb-6">
          <h2 id="recent-posts" class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />

  <HeadingLinks />
</Layout>

<script>
  const indexLayout = (document.querySelector("#main-content") as HTMLElement)
    ?.dataset;
  const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  if (indexLayout?.layout) {
    sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
  }
</script>
