---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import GithubWall from "@/components/GithubWall.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import RepoStats from "@/components/RepoStats.astro";
import HeadingLinks from "@/components/HeadingLinks.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { serialiseJsonLd } from "@/utils/jsonLd";
import {
  moduleCount,
  totalStars,
  totalForks,
  nixosCategories,
} from "@/data/nixos";
import { contributions } from "@/data/contributions";
import { repoStatsFor } from "@/data/githubRepos";
import config from "@/config";

const { socials, posts: postsConfig } = config;

// WebSite + SearchAction: lets Google offer a sitelinks search box. The target
// points at the Pagefind search page, which reads ?q=.
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: config.site.url,
  name: config.site.title,
  description: config.site.description,
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${config.site.url}search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={serialiseJsonLd(websiteLd)}
    />
  </Fragment>

  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 mr-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hello World
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Notes on Linux, CLI tooling and web development. I write up what I've
        had to work out myself: Arch setups, terminal configuration, and how the
        parts of a stack behave once you look closely.
      </p>
      <p class="mt-2">
        Posts are below. There's also{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="/about"
        >
          more about me
        </LinkButton>.
      </p>

      <div class="mt-6">
        <GithubWall />
        <details class="mt-1 flex flex-col items-end text-sm">
          <summary
            class="hover:text-accent cursor-pointer list-none opacity-50"
          >
            ?
          </summary>
          <p class="text-muted-foreground mt-1 text-right italic">
            If you don't know what this wall represents, you will not understand
            a thing here.
          </p>
        </details>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section class="border-border border-b pt-12 pb-6">
          <h2 id="featured" class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section
      class:list={[
        "pt-12 pb-6",
        { "border-border border-b": recentPosts.length > 0 },
      ]}
    >
      <div class="border-accent/40 bg-accent/5 rounded-lg border p-6 sm:p-8">
        <h2 id="nixos" class="text-2xl font-semibold tracking-wide">
          NixOS config
        </h2>
        <p class="text-muted-foreground mt-2 max-w-prose">
          My NixOS setup is split into one module per tool, each in its own
          repo, from the window manager down to the shell.
        </p>

        <div class="text-accent/80 mt-5 flex flex-wrap gap-4">
          {
            nixosCategories.map(category => (
              <span title={`${category.title} modules`} class="inline-flex">
                <CategoryIcon icon={category.icon} class="h-6 w-6" />
              </span>
            ))
          }
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-4">
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">
              {moduleCount}
            </div>
            <div class="text-muted-foreground mt-1 text-sm">modules</div>
          </div>
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">
              {totalStars}
            </div>
            <div class="text-muted-foreground mt-1 text-sm">stars</div>
          </div>
          <div class="text-center">
            <div class="text-accent text-3xl leading-none font-bold">
              {totalForks}
            </div>
            <div class="text-muted-foreground mt-1 text-sm">forks</div>
          </div>
          <a
            href="/nixos"
            class="focus-outline bg-accent text-accent-foreground ms-auto inline-flex items-center gap-2 rounded-md px-4 py-2 font-medium transition-opacity hover:opacity-90"
          >
            Browse the config
            <IconArrowRight class="rtl:-rotate-180" />
          </a>
        </div>
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section class="pt-12 pb-6">
          <h2 id="recent-posts" class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

    <section class="border-border border-t pt-12 pb-6">
      <h2 id="contributions" class="text-2xl font-semibold tracking-wide">
        Open source contributions
      </h2>
      <p class="text-muted-foreground mt-2 max-w-prose">
        Projects I contribute to beyond my own.
      </p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          contributions.map(project => {
            const stats = repoStatsFor(project.repo);
            return (
              <li class="border-border rounded-md border p-3">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="focus-outline group block"
                >
                  <span class="text-accent font-semibold group-hover:underline">
                    {project.repo}
                  </span>
                  {project.inactive && (
                    <span
                      title="No longer maintained"
                      class="ms-2 rounded border border-orange-600/40 bg-orange-500/10 px-1.5 py-0.5 align-middle text-xs font-medium text-orange-700 dark:border-orange-400/40 dark:text-orange-400"
                    >
                      inactive
                    </span>
                  )}
                  <span class="text-muted-foreground mt-1 block text-sm">
                    {project.description}
                  </span>
                  <RepoStats
                    stars={stats.stars}
                    forks={stats.forks}
                    class="mt-2"
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>
  <Footer />

  <HeadingLinks />
</Layout>

<script>
  const indexLayout = (document.querySelector("#main-content") as HTMLElement)
    ?.dataset;
  const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  if (indexLayout?.layout) {
    sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
  }
</script>
