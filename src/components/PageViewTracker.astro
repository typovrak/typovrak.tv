---
// Records a view for every page, and fills the counts shown on it:
// - `[data-page-views]`: the current page, from the POST that records the view.
// - `[data-views-path]`: article previews, from one batch GET (read-only).
// Rendered once, in the root layout.
---

<script>
  const nf = new Intl.NumberFormat();

  function drop(el: Element) {
    el.closest(".page-views")?.remove();
  }

  function recordCurrent() {
    const current = document.querySelectorAll("[data-page-views]");
    fetch("/api/views", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ path: window.location.pathname }),
    })
      .then(res => (res.ok ? res.json() : Promise.reject(res.status)))
      .then(({ views }) => {
        current.forEach(el => (el.textContent = nf.format(views)));
      })
      .catch(() => current.forEach(drop));
  }

  function fillPreviews() {
    const els = [...document.querySelectorAll("[data-views-path]")];
    if (els.length === 0) return;

    const params = new URLSearchParams();
    for (const path of new Set(
      els.map(el => el.getAttribute("data-views-path")).filter(Boolean)
    )) {
      params.append("path", path as string);
    }

    fetch(`/api/views?${params}`)
      .then(res => (res.ok ? res.json() : Promise.reject(res.status)))
      .then(({ views }) => {
        els.forEach(el => {
          const count = views[el.getAttribute("data-views-path") ?? ""];
          if (typeof count === "number") el.textContent = nf.format(count);
          else drop(el);
        });
      })
      .catch(() => els.forEach(drop));
  }

  function track() {
    recordCurrent();
    fillPreviews();
  }

  track();
  // ClientRouter swaps the DOM without a reload, so each navigation re-runs it.
  document.addEventListener("astro:after-swap", track);
</script>
