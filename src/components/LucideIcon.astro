---
// Lucide (MIT) line icons, inlined so they inherit the current text colour and
// need no dependency. Rendered as real elements, not set:html, to keep the CSP
// strict. Names must match the icon set in src/data/nixos.ts and
// src/data/tags.ts.
// Brand marks come from Simple Icons (CC0) instead, since Lucide dropped its
// logo set. They are solid shapes, so each one overrides the stroke defaults
// above with fill=currentColor.
type Props = {
  icon: string;
  class?: string;
};

const { icon, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={["h-5 w-5 shrink-0", className]}
>
