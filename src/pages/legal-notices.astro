---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import HeadingLinks from "@/components/HeadingLinks.astro";
import config from "@/config";

const legal = await getEntry("pages", "legal-notices");

if (!legal) {
  throw new Error(
    "Missing content entry: `legal-notices.md` in `src/content/pages/`"
  );
}

const { Content } = await render(legal);
---

<Layout
  title={`${legal.data.title} | ${config.site.title}`}
  description={legal.data.description}
  ogImage={legal.data.ogImage}
  canonicalURL={legal.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={legal.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />

  <HeadingLinks />
</Layout>
