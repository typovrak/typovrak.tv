---
import contributions from "@/data/github-contributions.json";
import config from "@/config";

const profile =
  config.socials.find(s => s.name === "github")?.url ??
  "https://github.com/typovrak";
const weeks = contributions.weeks.length;

// Drawn as one SVG rather than a CSS grid: a 1fr grid rounds each cell to a
// whole pixel independently, so at full width some cells land 1px off and the
// wall looks uneven. The SVG scales as a single transform, so cells, gaps and
// radius stay perfectly uniform at any width.
const CELL = 12;
const PITCH = 14; // 12 cell + 2 gap, in viewBox units
const width = weeks * PITCH - (PITCH - CELL);
const height = 7 * PITCH - (PITCH - CELL);

// Binary on purpose: a day either has activity or it does not. The GraphQL
// contribution counts undercount, so the four intensity levels drawn from them
// were misleading. Restore the shading below once the counts are trustworthy.
// 60% keeps the active day 3.7:1 against an empty one, well clear of the 3:1
// graphical threshold, without matching body text at full accent's 11:1.
const cellClass = (level: number) =>
  level > 0 ? "fill-accent/60" : "fill-muted";

// const levelClass = [
//   "fill-muted",
//   "fill-accent/30",
//   "fill-accent/60",
//   "fill-accent/80",
//   "fill-accent",
// ];
---

{
  weeks > 0 && (
    <a
      href={profile}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${contributions.total} GitHub contributions in the last year`}
      class="focus-outline block w-full"
    >
      <svg
        viewBox={`0 0 ${width} ${height}`}
        width="100%"
        aria-hidden="true"
        class="block h-auto w-full"
      >
        {contributions.weeks.map((week, wi) =>
          week.days.map((day, di) => (
            <rect
              x={wi * PITCH}
              y={di * PITCH}
              width={CELL}
              height={CELL}
              rx="2"
              class:list={["wall-cell", cellClass(day.level)]}
              style={`animation-delay:${300 + Math.round(Math.random() * 2500)}ms`}
            >
              <title>{`${day.count} contribution${day.count === 1 ? "" : "s"} on ${day.date}`}</title>
            </rect>
          ))
        )}
      </svg>
    </a>
  )
}

<style>
  /* Each cell fades in on load with a per-cell random delay (set inline), so
     the wall builds up in a random order. Opacity only: animating a transform
     on hundreds of SVG rects janks, opacity stays on the compositor. */
  .wall-cell {
    opacity: 0;
    animation: wall-cell-in 0.7s ease-out forwards;
  }
  @keyframes wall-cell-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wall-cell {
      opacity: 1;
      animation: none;
    }
  }
</style>
