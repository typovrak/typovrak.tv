---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import HeadingLinks from "@/components/HeadingLinks.astro";
import RepoStats from "@/components/RepoStats.astro";
import LucideIcon from "@/components/LucideIcon.astro";
import ModuleRequestForm from "@/components/ModuleRequestForm.astro";
import { slugifyStr } from "@/utils/slugify";
import {
  nixosCategories,
  nixosRepoUrl,
  moduleUrl,
  moduleStatsFor,
  moduleNixos,
  nixosVersion,
  popularityCard,
} from "@/data/nixos";
import { repoStatsFor } from "@/data/githubRepos";
import config from "@/config";

const title = "NixOS";
const description = "My NixOS configuration, split into one module per tool.";
const coreStats = repoStatsFor("nixos");
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={title}>
    <p>
      My NixOS setup is split into one module per tool, each in its own repo.
      The modules are grouped below by what they configure.
    </p>

    <a
      href={nixosRepoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="focus-outline group border-accent hover:bg-accent/5 mt-6 block rounded-lg border-2 p-5 sm:p-6"
    >
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="text-accent text-2xl font-bold group-hover:underline">
          nixos
        </span>
        <span class="text-muted-foreground text-sm">the core config</span>
      </div>
      <p class="mt-2">
        The umbrella config that ties every module below together: shell,
        desktop, development tools, window manager, audio, fonts and theming.
      </p>
      <div class="mt-3 flex items-center justify-between">
        <RepoStats stars={coreStats.stars} forks={coreStats.forks} />
        <span class="text-muted-foreground text-xs">NixOS {nixosVersion}</span>
      </div>
    </a>

    {
      nixosCategories.map(category => (
        <section class="mt-10">
          <h2
            id={slugifyStr(category.title)}
            class="flex items-center gap-2 text-xl font-semibold tracking-wide"
          >
            <LucideIcon icon={category.icon} class="text-accent" />
            {category.title}
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {category.modules.map(module => {
              const stats = moduleStatsFor(module.name);
              return (
                <li
                  class:list={[
                    "flex rounded-md border p-3",
                    popularityCard(stats),
                  ]}
                >
                  <a
                    href={moduleUrl(module.name)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="focus-outline group flex flex-1 flex-col"
                  >
                    <span>
                      <span class="text-accent font-semibold group-hover:underline">
                        {module.name}
                      </span>
                      {stats.archived && (
                        <span class="ms-2 rounded border border-orange-400/40 bg-orange-500/10 px-1.5 py-0.5 align-middle text-xs font-medium text-orange-400">
                          archived
                        </span>
                      )}
                    </span>
                    <span class="text-muted-foreground mt-1 block text-sm">
                      {module.purpose}
                    </span>
                    <div class="mt-auto flex items-center justify-between pt-2">
                      <RepoStats stars={stats.stars} forks={stats.forks} />
                      <span class="text-muted-foreground text-xs">
                        NixOS {moduleNixos(module)}
                      </span>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <section class="border-border mt-12 border-t pt-8">
      <h2 id="request-a-module" class="text-xl font-semibold tracking-wide">
        Request a new module?
      </h2>
      <p class="text-muted-foreground mt-2 max-w-prose">
        Ask for a tool that is not here yet and I can build a NixOS module for
        it, in the Catppuccin Mocha green theme and wired to fit this
        configuration.
      </p>
      <ModuleRequestForm />
    </section>
  </Main>

  <Footer />

  <HeadingLinks />
</Layout>
