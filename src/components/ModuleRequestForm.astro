---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const privacyUrl = getRelativeLocaleUrl(locale, "privacy-policy");

const field =
  "border-border bg-background focus:outline-accent w-full rounded-md border px-3 py-2 outline-none focus:outline-2";
---

<form data-module-request class="mt-4 flex flex-col gap-4">
  <div class="flex flex-col gap-1">
    <label for="mr-module" class="text-sm font-medium">Module</label>
    <input
      id="mr-module"
      name="module"
      type="text"
      required
      maxlength="100"
      autocomplete="off"
      placeholder="The tool to package, e.g. waybar"
      class={field}
    />
  </div>

  <div class="flex flex-col gap-1">
    <label for="mr-details" class="text-sm font-medium">Details</label>
    <textarea
      id="mr-details"
      name="details"
      rows="3"
      required
      maxlength="2000"
      placeholder="What it should do, options you care about, links…"
      class={field}></textarea>
  </div>

  <div class="flex flex-col gap-1">
    <label for="mr-email" class="text-sm font-medium">Email</label>
    <input
      id="mr-email"
      name="email"
      type="email"
      required
      maxlength="200"
      autocomplete="email"
      placeholder="So I can reply"
      class={field}
    />
  </div>

  <div class="flex flex-col gap-1">
    <label for="mr-captcha" class="text-sm font-medium">Code</label>
    <div class="flex flex-wrap items-center gap-3">
      <div
        data-captcha-image
        class="text-accent border-border bg-background flex h-[60px] w-[190px] items-center justify-center rounded-md border"
      >
      </div>
      <button
        type="button"
        data-captcha-reload
        class="focus-outline border-border hover:text-accent rounded-md border px-3 py-2 text-sm"
      >
        New code
      </button>
    </div>
    <input
      id="mr-captcha"
      name="captchaCode"
      type="text"
      required
      maxlength="12"
      autocomplete="off"
      autocapitalize="characters"
      spellcheck="false"
      placeholder="Type the code above"
      class={field}
    />
    <p class="text-muted-foreground text-xs">
      Can't read it? Write to{" "}
      <a
        href="mailto:typovrak@gmail.com"
        class="text-accent underline-offset-4 hover:underline"
      >
        typovrak@gmail.com
      </a>{" "}
      instead.
    </p>
  </div>

  {/* Honeypot: hidden from people, tempting to bots. */}
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="hidden"
  />

  <label class="flex items-start gap-2 text-sm">
    <input
      name="consent"
      type="checkbox"
      required
      class="accent-accent mt-0.5"
    />
    <span>
      I agree that my email and request are stored and sent to the maintainer so
      they can reply, as described in the{" "}
      <a
        href={privacyUrl}
        class="text-accent underline-offset-4 hover:underline"
      >
        privacy policy
      </a>.
    </span>
  </label>

  <div class="flex items-center gap-3">
    <button
      type="submit"
      class="focus-outline bg-accent text-accent-foreground inline-flex items-center rounded-md px-4 py-2 font-medium transition-opacity hover:opacity-90 disabled:opacity-60"
    >
      Send request
    </button>
    <p
      data-module-request-status
      role="status"
      aria-live="polite"
      class="text-sm"
    >
    </p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-module-request]");
  if (form) {
    const status = form.querySelector<HTMLElement>(
      "[data-module-request-status]"
    )!;
    const button = form.querySelector<HTMLButtonElement>(
      "button[type=submit]"
    )!;

    const value = (name: string) =>
      (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? "";

    // Orange for problems, matching the archived badge on this page.
    const setStatus = (text: string, tone: "ok" | "error") => {
      status.className =
        tone === "ok"
          ? "text-accent text-sm"
          : "text-sm text-orange-700 dark:text-orange-400";
      status.textContent = text;
    };

    const image = form.querySelector<HTMLElement>("[data-captcha-image]")!;
    const reload = form.querySelector<HTMLButtonElement>(
      "[data-captcha-reload]"
    )!;
    const codeInput = form.querySelector<HTMLInputElement>("#mr-captcha")!;
    let captchaToken = "";

    // The markup is generated by our own endpoint, never from user input.
    const loadCaptcha = async () => {
      captchaToken = "";
      image.textContent = "…";
      try {
        const response = await fetch("/api/captcha", { cache: "no-store" });
        if (!response.ok) throw new Error(String(response.status));
        const data = await response.json();
        captchaToken = data.token;
        image.innerHTML = data.svg;
      } catch {
        image.textContent = "unavailable";
      }
    };

    reload.addEventListener("click", () => {
      codeInput.value = "";
      loadCaptcha();
    });

    loadCaptcha();

    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      status.textContent = "";
      button.disabled = true;

      try {
        const response = await fetch("/api/module-request", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            module: value("module"),
            details: value("details"),
            email: value("email"),
            website: value("website"),
            consent: (form.elements.namedItem("consent") as HTMLInputElement)
              .checked,
            captchaToken,
            captchaCode: value("captchaCode"),
          }),
        });

        const failure =
          response.ok || response.status === 503
            ? null
            : await response.json().catch(() => null);

        if (response.ok) {
          form.reset();
          setStatus("Thanks, your request was sent.", "ok");
          loadCaptcha();
        } else if (failure?.error === "captcha") {
          setStatus("Wrong code. Here is a new one.", "error");
          codeInput.value = "";
          loadCaptcha();
        } else if (response.status === 429) {
          setStatus(
            `You already sent ${failure?.limit ?? 3} requests today. Try again tomorrow, or reply to the confirmation email.`,
            "error"
          );
        } else if (response.status === 503) {
          setStatus("The form is unavailable right now. Try later.", "error");
        } else {
          setStatus(
            "Something went wrong. Check the fields and retry.",
            "error"
          );
        }
      } catch {
        setStatus("Network error. Please try again.", "error");
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
