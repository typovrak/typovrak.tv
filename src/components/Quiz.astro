---
import type { QuizQuestion } from "@/utils/quiz";

interface Props {
  questions: QuizQuestion[];
}

const { questions } = Astro.props;
---

<section
  data-quiz
  aria-labelledby="quiz"
  class="border-border mt-8 rounded-lg border p-5 sm:p-6"
>
  <h2 id="quiz" class="text-xl font-semibold tracking-wide">Test yourself</h2>

  <ol class="mt-6 flex list-none flex-col gap-10 p-0">
    {
      questions.map((question, qi) => (
        <li data-quiz-question data-correct={question.correct.join(",")}>
          <fieldset class="m-0 border-0 p-0">
            <legend class="font-medium">
              {qi + 1}. {question.q}
            </legend>
            <p class="text-muted-foreground mt-1 text-sm">
              {question.multiple
                ? "Select at least 2 answers"
                : "Select one answer"}
            </p>
            <div class="mt-3 flex flex-col gap-2">
              {question.options.map((option, oi) => (
                <label class="quiz-option border-border hover:border-accent/60 relative flex cursor-pointer items-center gap-2 overflow-hidden rounded-md border px-3 py-2 transition-colors">
                  <span data-quiz-fill class="quiz-bar" aria-hidden="true" />
                  <span data-quiz-fill class="quiz-meter" aria-hidden="true" />
                  <input
                    class="accent-accent relative"
                    type={question.multiple ? "checkbox" : "radio"}
                    name={`quiz-${qi}`}
                    value={oi}
                  />
                  <span class="relative">{option}</span>
                  <span
                    data-quiz-pct
                    hidden
                    class="relative ml-auto pl-2 text-xs tabular-nums"
                  />
                </label>
              ))}
            </div>
            <button
              type="button"
              data-quiz-validate
              hidden
              class="focus-outline bg-accent text-accent-foreground mt-3 inline-flex w-fit items-center rounded-md px-3 py-1.5 text-sm font-medium transition-opacity hover:opacity-90"
            >
              Validate
            </button>
            <p data-quiz-mark hidden class="quiz-mark" />
            {question.explain && (
              <p
                data-quiz-explain
                hidden
                class="text-muted-foreground mt-1 text-sm"
              >
                {question.explain}
              </p>
            )}
            <p
              data-quiz-summary
              hidden
              aria-live="polite"
              class="text-muted-foreground mt-1 text-sm"
            />
          </fieldset>
        </li>
      ))
    }
  </ol>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    <button
      type="button"
      data-quiz-retry
      hidden
      class="focus-outline border-accent text-accent hover:bg-accent/10 inline-flex items-center rounded-md border px-4 py-2 font-medium transition-colors"
    >
      Retry
    </button>
    <p
      data-quiz-score
      hidden
      tabindex="-1"
      aria-live="polite"
      class="text-accent font-semibold"
    >
    </p>
    <p
      data-quiz-average
      hidden
      aria-live="polite"
      class="text-muted-foreground text-sm"
    >
    </p>
  </div>
</section>

<script>
  import {
    averagePercent,
    isAnswerCorrect,
    optionPercents,
    percentOf,
    scoreQuiz,
    type QuizAnswerStats,
    type QuizResultStats,
  } from "@/utils/quiz";
  import { celebrate } from "@/scripts/confetti";

  const picks = (question: HTMLElement) =>
    Array.from(question.querySelectorAll<HTMLInputElement>("input"));

  const correctOf = (question: HTMLElement) =>
    (question.dataset.correct ?? "")
      .split(",")
      .filter(value => value !== "")
      .map(Number);

  const options = (question: HTMLElement) =>
    Array.from(question.querySelectorAll<HTMLElement>(".quiz-option"));

  const post = async <T,>(url: string, body: unknown): Promise<T | null> => {
    try {
      const response = await fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      return response.ok ? ((await response.json()) as T) : null;
    } catch {
      return null;
    }
  };

  const plural = (count: number, word: string) =>
    `${count} ${word}${count === 1 ? "" : "s"}`;

  function setupQuiz(quiz: HTMLElement): void {
    const questions = Array.from(
      quiz.querySelectorAll<HTMLElement>("[data-quiz-question]")
    );
    const retry = quiz.querySelector<HTMLButtonElement>("[data-quiz-retry]");
    const scoreEl = quiz.querySelector<HTMLElement>("[data-quiz-score]");
    const averageEl = quiz.querySelector<HTMLElement>("[data-quiz-average]");
    if (!retry || !scoreEl || !averageEl) return;

    // one POST per question per page load, so retrying cannot inflate the
    // percentages everyone reads. the reply is cached and replayed instead.
    const answerStats = new Map<HTMLElement, QuizAnswerStats | null>();
    let resultStats: QuizResultStats | null = null;
    let resultSent = false;

    const showAnswerStats = (question: HTMLElement) => {
      const stats = answerStats.get(question);
      const summary = question.querySelector<HTMLElement>(
        "[data-quiz-summary]"
      );
      if (!stats || stats.answers === 0) return;

      const labels = options(question);
      const percents = optionPercents(stats, labels.length);
      labels.forEach((label, index) => {
        const width = `${Math.min(percents[index], 100)}%`;
        label
          .querySelectorAll<HTMLElement>("[data-quiz-fill]")
          .forEach(fill => (fill.style.width = width));
        const pct = label.querySelector<HTMLElement>("[data-quiz-pct]");
        if (pct) {
          pct.hidden = false;
          pct.textContent = `${percents[index]}%`;
        }
      });

      if (summary) {
        summary.hidden = false;
        summary.textContent = `${percentOf(stats.correct, stats.answers)}% answered this correctly, out of ${plural(stats.answers, "answer")}`;
      }
    };

    // grade one question inline and lock it
    const gradeQuestion = async (question: HTMLElement) => {
      const correct = correctOf(question);
      const selected = picks(question)
        .filter(input => input.checked)
        .map(input => Number(input.value));
      const ok = isAnswerCorrect(selected, correct);

      picks(question).forEach(input => {
        const label = input.closest(".quiz-option");
        if (!label) return;
        if (correct.includes(Number(input.value))) {
          label.classList.add("is-correct");
        } else if (input.checked) {
          label.classList.add("is-wrong");
        }
      });

      const mark = question.querySelector<HTMLElement>("[data-quiz-mark]");
      if (mark) {
        mark.hidden = false;
        mark.textContent = ok ? "True" : "False";
        mark.classList.add(ok ? "is-ok" : "is-ko");
      }
      const explain = question.querySelector<HTMLElement>(
        "[data-quiz-explain]"
      );
      if (explain) explain.hidden = false;

      question.dataset.validated = "true";
      question.classList.add("is-graded");

      // anonymous per-question record, best-effort. the reply carries the
      // aggregate for that question, so no second request is needed.
      if (!answerStats.has(question)) {
        answerStats.set(
          question,
          await post<QuizAnswerStats>("/api/quiz-answer", {
            path: location.pathname,
            question: questions.indexOf(question),
            picked: selected,
            correct: ok,
          })
        );
      }
      showAnswerStats(question);
    };

    // show retry after the first validation, the total once every one is done
    const updateSummary = async () => {
      const done = questions.filter(q => q.dataset.validated === "true");
      if (done.length > 0) retry.hidden = false;
      if (done.length !== questions.length) return;

      const graded = questions.map(question => ({
        selected: picks(question)
          .filter(input => input.checked)
          .map(input => Number(input.value)),
        correct: correctOf(question),
      }));
      const { correct, total, percent } = scoreQuiz(graded);
      scoreEl.hidden = false;
      scoreEl.textContent = `You scored ${correct} / ${total} (${percent}%)`;
      scoreEl.focus();

      if (total > 0 && correct === total) celebrate();

      // anonymous final score, best-effort, recorded once per page load
      if (!resultSent) {
        resultSent = true;
        resultStats = await post<QuizResultStats>("/api/quiz-result", {
          path: location.pathname,
          correct,
          total,
        });
      }
      if (resultStats && resultStats.completions > 0) {
        averageEl.hidden = false;
        averageEl.textContent = `Average ${averagePercent(resultStats)}% across ${plural(resultStats.completions, "completion")}`;
      }
    };

    questions.forEach(question => {
      const validate = question.querySelector<HTMLButtonElement>(
        "[data-quiz-validate]"
      );
      if (!validate) return;

      question.addEventListener("change", () => {
        if (question.dataset.validated === "true") return;
        validate.hidden = !picks(question).some(input => input.checked);
      });

      validate.addEventListener("click", () => {
        validate.hidden = true;
        void gradeQuestion(question).then(updateSummary);
      });
    });

    retry.addEventListener("click", () => {
      questions.forEach(question => {
        delete question.dataset.validated;
        question.classList.remove("is-graded");
        picks(question).forEach(input => {
          input.checked = false;
          input
            .closest(".quiz-option")
            ?.classList.remove("is-correct", "is-wrong");
        });
        options(question).forEach(label => {
          label
            .querySelectorAll<HTMLElement>("[data-quiz-fill]")
            .forEach(fill => (fill.style.width = ""));
          const pct = label.querySelector<HTMLElement>("[data-quiz-pct]");
          if (pct) {
            pct.hidden = true;
            pct.textContent = "";
          }
        });
        const validate = question.querySelector<HTMLButtonElement>(
          "[data-quiz-validate]"
        );
        if (validate) validate.hidden = true;
        const mark = question.querySelector<HTMLElement>("[data-quiz-mark]");
        if (mark) {
          mark.hidden = true;
          mark.textContent = "";
          mark.classList.remove("is-ok", "is-ko");
        }
        const explain = question.querySelector<HTMLElement>(
          "[data-quiz-explain]"
        );
        if (explain) explain.hidden = true;
        const summary = question.querySelector<HTMLElement>(
          "[data-quiz-summary]"
        );
        if (summary) {
          summary.hidden = true;
          summary.textContent = "";
        }
      });
      scoreEl.hidden = true;
      scoreEl.textContent = "";
      averageEl.hidden = true;
      averageEl.textContent = "";
      retry.hidden = true;
    });
  }

  document.querySelectorAll<HTMLElement>("[data-quiz]").forEach(setupQuiz);
</script>
